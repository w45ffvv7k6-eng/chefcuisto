# Copie ce fichier en ".env.local" pour lancer l'app sur ton ordinateur.
# Ces deux valeurs se trouvent dans Supabase : Project Settings → API.
# La clé "anon" est publique par nature : elle ne donne accès qu'aux données
# autorisées par les règles de sécurité (chacun ne voit que ses recettes).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
